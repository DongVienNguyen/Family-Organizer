{
  "name": "react-example",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs --define:import.meta.dirname=__dirname",
    "start": "node dist/server.cjs",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "release": "node scripts/release-disabled.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "data:migrate": "node scripts/migrate-data.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "archiver": "^8.0.0",
    "better-sqlite3": "13.0.3",
    "dotenv": "^17.2.3",
    "express": "4.22.3",
    "heic2any": "^0.0.4",
    "lucide-react": "^0.546.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "motion": "^12.23.24",
    "pdfmake": "^0.3.11",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "unzipper": "^0.12.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "24.19.2",
    "@types/pdfmake": "^0.3.3",
    "@types/unzipper": "^0.10.11",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "react-i18next": "^17.0.11",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.8"
  },
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "22.23.3 || 24.21.0",
    "npm": "10.9.9 || 11.19.0"
  }
}
